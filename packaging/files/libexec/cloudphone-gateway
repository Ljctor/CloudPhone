#!/bin/sh
set -eu

# The emulator publishes its gRPC port and token in a discovery file under its
# XDG_RUNTIME_DIR. Reading the token from there keeps it out of /proc cmdlines.
discovery=
while [ -z "$discovery" ]; do
  discovery=$(find /run/cloudphone/avd/running -maxdepth 1 -type f -name 'pid_*.ini' -print -quit 2>/dev/null || true)
  [ -n "$discovery" ] || sleep 1
done

exec /opt/cloudphone/current/venv/bin/videobridge-gateway \
  --host "${LISTEN_ADDRESS:-0.0.0.0}" \
  --port 8001 \
  --adb /opt/cloudphone/android-sdk/platform-tools/adb \
  --adb_serial "emulator-${EMULATOR_PORT:-5558}" \
  --discovery_file "$discovery"
