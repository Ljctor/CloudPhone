#!/usr/bin/env bash
# Applies a screen size requested from the web page. Run as root by
# cloudphone-display.service when the gateway (service user) writes
# /var/lib/cloudphone/display-request containing "WIDTH HEIGHT DENSITY".
#
# The request file is in a directory the service user controls, so it is
# treated as hostile: symlinks are refused, at most 64 bytes are read, the
# content is never logged, and only bounded even integers are accepted. The
# status goes to this service's own runtime directory, which only root can
# write, for the gateway to report on the page.
set -euo pipefail

request=/var/lib/cloudphone/display-request
status=/run/cloudphone-display/status
tools=/opt/cloudphone/tools

report() {
  local tmp
  tmp=$(mktemp /run/cloudphone-display/.status.XXXXXX)
  printf '%s\n' "$*" >"$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$status"
}

[ -e "$request" ] || [ -L "$request" ] || exit 0
if [ -L "$request" ] || [ ! -f "$request" ]; then
  rm -f "$request"
  report "failed invalid request"
  exit 0
fi
line=$(head -c 64 "$request" | head -n 1)
rm -f "$request"

if ! [[ $line =~ ^([0-9]{3,4})\ ([0-9]{3,4})\ ([0-9]{2,3})$ ]]; then
  report "failed invalid request"
  exit 0
fi
width=$((10#${BASH_REMATCH[1]})) height=$((10#${BASH_REMATCH[2]})) density=$((10#${BASH_REMATCH[3]}))
if [ $((width % 2)) -ne 0 ] || [ $((height % 2)) -ne 0 ] ||
  [ "$width" -lt 240 ] || [ "$width" -gt 1440 ] ||
  [ "$height" -lt 320 ] || [ "$height" -gt 3200 ] ||
  [ "$density" -lt 80 ] || [ "$density" -gt 640 ]; then
  report "failed out of range"
  exit 0
fi

report "applying $width $height $density"
if "$tools/03-android-emulator/scripts/set-resolution.sh" "$width" "$height" "$density"; then
  report "done $width $height $density"
else
  report "failed set-resolution.sh: journalctl -u cloudphone-display"
fi
