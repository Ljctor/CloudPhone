      "kind": "screen", "status": "registered", "legacy": "sign_in",
      "anchors": [
        {"patch": "sign_in_buttons", "limit": 0.6},
        {"reader": "sign_in"}
      ],
      "fixtures": ["sign_in_buttons"], "background": [90, 60, 35]
    },
    "battle": {
