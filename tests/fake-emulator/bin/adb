#!/bin/sh
# Fake adb for the gateway under test: `adb -s SERIAL shell ...`.
# Logs every call, answers the Android metrics script with canned output,
# accepts `input keyevent KEY` (or never answers it, with adb-hang) and
# `input tap X Y` (the fake emulator reads the log), `am start` and
# `dumpsys window` (the launcher has the focus). With an app (the fake's
# "app" option, files bin-state/app-*): `pidof` it, `am start -n` it
# (running after its start time), its crash dialog in `dumpsys window` and
# `uiautomator dump`, closed by an `input tap` on its "Close app" button,
# and its "not responding" dialog (state anr): "Wait" (the same place)
# leaves it there, "Close app" below it kills the app. State signin: the
# app asks to sign in; an `input tap` on its button (app-google) opens
# Google's account chooser (state chooser: its window in `dumpsys window`,
# its accounts, app-accounts, in `uiautomator dump`), where a tap on the
# one account listed signs in (running).
state=$FAKE_ROOT/bin-state
printf '%s\n' "$*" >>"$state/adb.log"
if [ -e "$state/adb-fail" ]; then
  echo "error: device 'emulator-5558' not found" >&2
  exit 1
fi
package=$(cat "$state/app-package" 2>/dev/null)
app=$(cat "$state/app-state" 2>/dev/null)
case "$app" in
  starting*) [ "$(date +%s)" -ge "${app#starting }" ] && app=running && echo running >"$state/app-state" ;;
esac
case "$*" in
  *"input keyevent"*) [ -e "$state/adb-hang" ] && exec sleep 60; exit 0 ;;
  *"input tap"*)
    if [ "$app" = crashed ]; then
      set -- $(echo "$*" | sed 's/.*input tap //') $(cat "$state/app-close")
      [ "$1" -ge "$3" ] && [ "$1" -le "$5" ] && [ "$2" -ge "$4" ] && [ "$2" -le "$6" ] && echo absent >"$state/app-state"
    elif [ "$app" = anr ]; then
      set -- $(echo "$*" | sed 's/.*input tap //') $(cat "$state/app-close")
      [ "$1" -ge "$3" ] && [ "$1" -le "$5" ] && [ "$2" -gt "$6" ] && [ "$2" -le $(($6 + $6 - $4)) ] && echo absent >"$state/app-state"
    elif [ "$app" = signin ] && [ -s "$state/app-google" ]; then
      set -- $(echo "$*" | sed 's/.*input tap //') $(cat "$state/app-google")
      [ "$1" -ge "$3" ] && [ "$1" -le "$5" ] && [ "$2" -ge "$4" ] && [ "$2" -le "$6" ] && echo chooser >"$state/app-state"
    elif [ "$app" = chooser ] && [ "$(wc -l <"$state/app-accounts")" -eq 1 ]; then
      set -- $(echo "$*" | sed 's/.*input tap //') $(cut -d' ' -f2- "$state/app-accounts")
      [ "$1" -ge "$3" ] && [ "$1" -le "$5" ] && [ "$2" -ge "$4" ] && [ "$2" -le "$6" ] && echo running >"$state/app-state"
    fi
    exit 0 ;;
  *"am start"*)
    echo "Starting: Intent { cmp=$(echo "$*" | sed 's/.* -n //; s/ .*//') }"
    case "$*" in
      *" -n $package/"*) [ -n "$package" ] && [ "$app" = absent ] &&
        echo "starting $(( $(date +%s) + $(cat "$state/app-start") ))" >"$state/app-state" ;;
    esac
    exit 0 ;;
  *"pidof"*)
    if [ "$app" = running ] || [ "$app" = anr ] || [ "$app" = signin ] || [ "$app" = chooser ]; then
      case "$*" in *" $package") echo 4242; exit 0 ;; esac
    fi
    exit 1 ;;
  *"uiautomator dump"*)
    if [ "$app" = crashed ]; then
      set -- $(cat "$state/app-close")
      printf '%s' "<?xml version='1.0' encoding='UTF-8' standalone='yes' ?><hierarchy rotation=\"0\">"
      printf '%s' "<node index=\"0\" text=\"Fake Game keeps stopping\" resource-id=\"android:id/alertTitle\" bounds=\"[$1,$(($2 - 120))][$3,$(($2 - 40))]\" />"
      printf '%s' "<node index=\"1\" text=\"Close app\" resource-id=\"android:id/aerr_close\" bounds=\"[$1,$2][$3,$4]\" />"
      printf '%s' "<node index=\"2\" text=\"App info\" resource-id=\"android:id/aerr_app_info\" bounds=\"[$1,$4][$3,$(($4 + $4 - $2))]\" />"
      printf '%s\n' "</hierarchy>"
    elif [ "$app" = anr ]; then
      set -- $(cat "$state/app-close")
      printf '%s' "<?xml version='1.0' encoding='UTF-8' standalone='yes' ?><hierarchy rotation=\"0\">"
      printf '%s' "<node index=\"0\" text=\"Fake Game isn't responding\" resource-id=\"android:id/alertTitle\" bounds=\"[$1,$(($2 - 120))][$3,$(($2 - 40))]\" />"
      printf '%s' "<node index=\"1\" text=\"Wait\" resource-id=\"android:id/aerr_wait\" bounds=\"[$1,$2][$3,$4]\" />"
      printf '%s' "<node index=\"2\" text=\"Close app\" resource-id=\"android:id/aerr_close\" bounds=\"[$1,$4][$3,$(($4 + $4 - $2))]\" />"
      printf '%s\n' "</hierarchy>"
    elif [ "$app" = chooser ]; then
      printf '%s' "<?xml version='1.0' encoding='UTF-8' standalone='yes' ?><hierarchy rotation=\"0\">"
      printf '%s' "<node index=\"0\" text=\"Choose an account\" package=\"com.google.android.gms\" bounds=\"[40,300][440,340]\" />"
      while read -r email left top right bottom; do
        printf '%s' "<node index=\"1\" text=\"$email\" package=\"com.google.android.gms\" bounds=\"[$left,$top][$right,$bottom]\" />"
      done <"$state/app-accounts"
      printf '%s\n' "<node index=\"2\" text=\"Add another account\" package=\"com.google.android.gms\" bounds=\"[40,900][440,950]\" /></hierarchy>"
    else
      printf '%s\n' "<?xml version='1.0' encoding='UTF-8' standalone='yes' ?><hierarchy rotation=\"0\"></hierarchy>"
    fi
    echo "UI hierchary dumped to: /dev/tty" ;;
  *"dumpsys window"*)
    case "$app" in
      running|signin) echo "  mCurrentFocus=Window{1 u0 $package/$(cat "$state/app-activity")}" ;;
      chooser) echo "  mCurrentFocus=Window{4 u0 com.google.android.gms/com.google.android.gms.common.account.AccountPickerActivity}" ;;
      crashed) echo "  mCurrentFocus=Window{2 u0 Application Error: $package}" ;;
      anr) echo "  mCurrentFocus=Window{3 u0 Application Not Responding: $package}" ;;
      *) echo "  mCurrentFocus=Window{0 u0 com.android.launcher3/.Launcher}" ;;
    esac ;;
  *timestats*)
    cat "$FAKE_ROOT/android/meminfo"
    echo "==TIMESTATS=="
    cat "$FAKE_ROOT/android/timestats"
    ;;
  *) echo "fake adb: unsupported: $*" >&2; exit 1 ;;
esac
