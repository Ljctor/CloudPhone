[Unit]
Description=VPN-only WebRTC gateway for the Android Emulator
After=android-emulator.service
Requires=android-emulator.service

[Service]
Type=simple
User=master
Group=master
UMask=0077
ExecStart=/usr/local/libexec/start-android-emulator-gateway
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
